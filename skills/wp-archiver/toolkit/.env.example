# Copy to .env (gitignored) and fill in. Every script and docker-compose.yml reads this one file.
# The DB/admin values are local-only dev credentials (the stack is bound to 127.0.0.1): generate fresh ones,
# never reuse a real password.

# ---- project ---------------------------------------------------------------------------------------
# Compose project name and container prefix; also the placeholder-email domain used by the DB scrub.
COMPOSE_PROJECT_NAME=example-site

# ---- facts about the SOURCE site (phases 01-03 give you all of them; see reference/site-config.md) ----
# WordPress / PHP / MySQL majors the old host ran. The dump's collation decides MySQL vs MariaDB (RST-3).
WP_VERSION=6.8.2
PHP_VERSION=8.2
MYSQL_VERSION=8.4
# From `CREATE TABLE` in the dump, or $table_prefix in wp-config.php.
TABLE_PREFIX=wp_
# Hosts baked into content, space-separated, no scheme (each is rewritten in its http:// and https:// forms).
OLD_HOSTS="old.example.site www.old.example.site temp.example.site"
# Directory name of the active theme (`wp option get stylesheet`).
ACTIVE_THEME=twentytwentyfive
# EXTRA_THEMES=parent-theme      # a child theme's parent (also kept by trim-archive.py)
# elementor | none | <other>. Selects builder-specific steps; see builders/README.md.
BUILDER=none
# Where the static copy will live. Only used for canonical/OG URLs and archive naming.
FINAL_URL=https://archive.example.site

# ---- optional overrides ------------------------------------------------------------------------------
# DUMP_FILE=export.sql           # needed only when archive/<host>/ holds more than one .sql file
# UPLOADS_SKIP="simply-static wp_encryption wpforms ai1wm-backups updraft backwpup siteground-optimizer-assets et_temp"   # uploads/ folders not copied locally
# ARCHIVE_NAME=example-site-host # basename of the trimmed archive zip (phase 10)

# ---- local credentials -------------------------------------------------------------------------------
DB_NAME=example_site
DB_USER=example_site
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
# Local admin created/updated by scripts/setup.sh on every run (the site's own logins are untouched).
WP_ADMIN_USER=localadmin
WP_ADMIN_EMAIL=localadmin@example-site.test
WP_ADMIN_PASSWORD=change-me-three
